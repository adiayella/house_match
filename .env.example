# ---------------------------------------------------------------------------
# HouseMatch — environment variables
#
# Copy the names into your Vercel project settings (Settings -> Environment
# Variables). Do not commit a filled-in copy of this file; .gitignore already
# excludes .env for that reason.
#
# Only TELEGRAM_BOT_TOKEN and SETUP_KEY are needed to get a working bot. The
# rest add durability and nicer wording.
# ---------------------------------------------------------------------------

# REQUIRED. From @BotFather on Telegram: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=

# REQUIRED to wire the webhook from a browser. Any long random string you
# invent. You will visit /api/setup?key=THIS_VALUE once after deploying.
SETUP_KEY=

# RECOMMENDED. Another random string. Telegram signs every webhook call with
# it, and /api/telegram rejects anything unsigned. Without it your webhook URL
# is a public endpoint that anyone who guesses it can post fake updates to.
TELEGRAM_WEBHOOK_SECRET=

# OPTIONAL. The group chat where the shortlist gets posted. Add the bot to the
# group and send /groupid there to find it (it starts with a minus sign), or
# just send /usegroup in the group and skip this variable entirely.
TELEGRAM_GROUP_CHAT_ID=

# OPTIONAL BUT STRONGLY RECOMMENDED. Without these the bot keeps answers in
# memory inside one warm serverless instance: they can disappear between
# messages, and two people answering at the same time may never see each
# other. Create a project at supabase.com, run schema.sql in its SQL editor,
# then take these from Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL. Turns on the plain-English tradeoff write-ups and lets people
# answer the travel question in their own words. Get one from
# aistudio.google.com. Everything still works without it: the bot falls back
# to its own deterministic wording, and matching is unaffected either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
